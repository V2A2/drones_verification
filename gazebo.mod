# Gazebo world template. Depend on it as `gazebo` with a `world` context var.
# Module identity is a hash of the rendered content, so every vehicle that
# resolves to the same world automatically shares one gz sim process.
#
# Context vars (optional):
#   args  extra args forwarded to `gz sim` (default: -r, start unpaused)
#
# GZ_PARTITION/GZ_IP must match what docker-compose.yml gives the px4-sitl
# containers (px4_sim / 127.0.0.1), otherwise the vehicles' gz_bridge can't
# discover the world. gz_env.sh (generated by the px4_sitl_default build)
# points GZ_SIM_RESOURCE_PATH / GZ_SIM_SYSTEM_PLUGIN_PATH at PX4's models,
# worlds and plugins — without it gz sim logs "Failed to load system plugin"
# for gz_bridge etc. Runs from PX4-Autopilot/, where that build lives.
process:
  cmd: |
    cd PX4-Autopilot
    export GZ_PARTITION=px4_sim GZ_IP=127.0.0.1
    . build/px4_sitl_default/rootfs/gz_env.sh
    exec gz sim -s {{ world | default('empty') }}.sdf {{ args | default('-r') }}

